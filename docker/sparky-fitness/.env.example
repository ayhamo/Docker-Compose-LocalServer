# =================================================================
# SparkyFitness - Production Environment Configuration
# =================================================================

# --- PostgreSQL Database Settings ---
SPARKY_FITNESS_DB_NAME=sparkyfitness_db
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=<CHANGE_ME>
SPARKY_FITNESS_APP_DB_USER=sparky_app
SPARKY_FITNESS_APP_DB_PASSWORD=<CHANGE_ME>
SPARKY_FITNESS_DB_HOST=sparkyfitness-db
SPARKY_FITNESS_DB_PORT=5432

# --- Core Security & Authentication ---
# Critical keys for session signing and data encryption
SPARKY_FITNESS_API_ENCRYPTION_KEY=<CHANGE_ME_openssl_rand_hex_32>
BETTER_AUTH_SECRET=<CHANGE_ME_openssl_rand_hex_32>

# Public domain accessed through Nginx Proxy Manager
SPARKY_FITNESS_FRONTEND_URL=https://sparky-fitness.example.com

# Login Behavior
SPARKY_FITNESS_DISABLE_SIGNUP=false
SPARKY_FITNESS_FORCE_EMAIL_LOGIN=true
SPARKY_FITNESS_DISABLE_PASSKEY_LOGIN=true
ALLOW_PRIVATE_NETWORK_CORS=true

# --- Server Runtime & Networking ---
NODE_ENV=production
TZ=Europe/Berlin
SPARKY_FITNESS_LOG_LEVEL=ERROR
SPARKY_FITNESS_SERVER_HOST=sparkyfitness-server
SPARKY_FITNESS_SERVER_PORT=3010
SPARKY_FITNESS_PUBLIC_API_DOCS=false

# --- Rate Limiting Settings ---
SPARKY_FITNESS_SIGN_IN_RATELIMIT_MAX=5
SPARKY_FITNESS_SIGN_IN_RATELIMIT_WINDOW=60
SPARKY_FITNESS_API_KEY_RATELIMIT_MAX_REQUESTS=100
SPARKY_FITNESS_API_KEY_RATELIMIT_WINDOW_MS=60000

# --- Persistent Host Storage Paths ---
DB_PATH=./postgresql
SERVER_BACKUP_PATH=./backup
SERVER_UPLOADS_PATH=./uploads

# --- Garmin Integration (Disabled until microservice is deployed) ---
GARMIN_MICROSERVICE_URL=http://sparkyfitness-garmin:8000
GARMIN_SERVICE_PORT=8000
GARMIN_SERVICE_IS_CN=false

# --- Email Settings (Optional - leave blank if not using SMTP) ---
SPARKY_FITNESS_ADMIN_EMAIL=
SPARKY_FITNESS_EMAIL_HOST=
SPARKY_FITNESS_EMAIL_PORT=
SPARKY_FITNESS_EMAIL_SECURE=
SPARKY_FITNESS_EMAIL_USER=
SPARKY_FITNESS_EMAIL_PASS=
SPARKY_FITNESS_EMAIL_FROM=
