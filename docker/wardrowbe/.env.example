# Generate each secret with: openssl rand -hex 32
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=
POSTGRES_DB=wardrobe
SECRET_KEY=
NEXTAUTH_SECRET=

NEXTAUTH_URL=https://wardrowbe.yourdomain.dedyn.io
APP_URL=https://wardrowbe.yourdomain.dedyn.io

# Login: NPM signs every request in as one user (forward-auth, no login page), like the other LAN/Tailscale-only apps.
# NPM's advanced config includes nginx-proxy-manager/data/nginx/custom/wardrowbe-auth.conf, which holds the same secret.
DEBUG=false
FORWARD_AUTH_SECRET=

# OpenRouter (OpenAI-compatible). One model each: despite upstream's comment, a comma list is sent
# as one model name. The vision model needs image input; free Gemma 4 is rate-limited upstream.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
AI_TEXT_MODEL=nvidia/nemotron-3.5-super-vl:free
AI_TIMEOUT=180
