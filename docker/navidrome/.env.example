# Last.fm API account for Navidrome scrobbling/metadata: https://www.last.fm/api/account/create
LASTFM_APIKEY=<CHANGE_ME>
LASTFM_SECRET=<CHANGE_ME>
# AudioMuse-AI's Postgres (used by audiomuse-postgres, -flask and -worker)
AUDIOMUSE_DB_PASSWORD=<CHANGE_ME>
# Navidrome header login name, trusted only from NPM; NPM removes it from every request (random, keep secret)
ND_EXTAUTH_USERHEADER=X-Nd-Proxy-User-<RANDOM_HEX>
